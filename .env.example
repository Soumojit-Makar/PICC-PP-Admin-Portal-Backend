# ==============================================================================
# PICC-PP-Admin-Portal-Backend - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# HTTP port on which the Spring Boot microservice listens (Default: 8080)
SERVER_PORT=8080

# Active Spring Profile (e.g., main, dev, local)
SPRING_PROFILES_ACTIVE=main

# CORS Allowed Origins (Comma-separated origins or * for permissive)
APP_CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL) Configuration
# ------------------------------------------------------------------------------
# JDBC Connection URL for the PostgreSQL database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nnp_dashboard
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
POSTGRES_DB=nnp_dashboard
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Message Broker (ActiveMQ Artemis JMS)
# ------------------------------------------------------------------------------
# ActiveMQ broker connection URL (Default: tcp://localhost:61616)
SPRING_ACTIVEMQ_BROKER_URL=tcp://localhost:61616
SPRING_ACTIVEMQ_USER=artemis
SPRING_ACTIVEMQ_PASSWORD=artemis
ACTIVEMQ_PORT=61616
ACTIVEMQ_CONSOLE_PORT=8161

# ------------------------------------------------------------------------------
# 4. Identity & Access Management (Keycloak)
# ------------------------------------------------------------------------------
# Base URL for the Keycloak identity provider service
KEYCLOAK_SERVICE_BASEURL=http://localhost:8080
KEYCLOAK_REALM_DEFAULT=master
KEYCLOAK_GROUP=nnp-users
KEYCLOAK_USER_GROUP=users
KEYCLOAK_ADMIN_GROUP=admins

# ------------------------------------------------------------------------------
# 5. HAProxy DataPlane API Integration
# ------------------------------------------------------------------------------
# Base URL for the PICC-PC-Haproxy-Integration microservice
HAPROXY_SERVICE_BASEURL=http://localhost:8081
HAPROXY_BASE_DOMAIN=nnp.example.com

# ------------------------------------------------------------------------------
# 6. Ecosystem Microservices (GitLab, Redmine, Mail, K8s)
# ------------------------------------------------------------------------------
# GitLab Integration Service
GITLAB_SERVICE_BASEURL=http://localhost:8089

# Redmine Issue Tracking Integration Service
REDMINE_SERVICE_BASEURL=http://localhost:3000
REDMINE_API_KEY=
REDMINE_SUPPORT_API_KEY=
REDMINE_SUPPORT_PROJECT_ID=1
REDMINE_SUPPORT_SUBJECT=Support Request
REDMINE_SUPPORT_PRIORITY_ID=2
REDMINE_SUPPORT_TRACKER_ID=1
REDMINE_SUPPORT_DESCRIPTION=Support request description

# Mail Notification Service
MAIL_SERVICE_BASEURL=http://localhost:8085
MAIL_USER_WELCOME_FROM_EMAIL=no-reply@nnp.example.com
MAIL_USER_WELCOME_FROM_NAME=NNP Admin
MAIL_USER_WELCOME_SUBJECT=Welcome to NNP
MAIL_USER_WELCOME_TEMPLATE_NAME=welcome-user
MAIL_USER_WELCOME_TEMPLATE_PARAM_NNP_NAME=NNP
MAIL_USER_WELCOME_TEMPLATE_PARAM_NNP_PORTAL_URL=https://nnp.example.com
MAIL_USER_WELCOME_TEMPLATE_PARAM_NNP_EMAIL=support@nnp.example.com
MAIL_USER_WELCOME_TEMPLATE_PARAM_NNP_ADMIN=admin@nnp.example.com

# Kubernetes API Gateway
K8S_API_URL=https://kubernetes.default.svc

# Default Environment Type
ENV_TYPE_DEFAULT=standard

# ------------------------------------------------------------------------------
# 7. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# Centralized configuration server URL (if used)
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_LABEL=v1

# ------------------------------------------------------------------------------
# 8. Logging & Observability
# ------------------------------------------------------------------------------
# Root and application log level (INFO, DEBUG, WARN, ERROR)
LOG_LEVEL=INFO
